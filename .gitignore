# Dependencies
node_modules

# Build output
dist
dist-ssr

# Generated DIY-kit zip ~ rebuilt by scripts/build_diy_kit.py and during CI deploy
public/KitsunePrints-DIY-Kit.zip

# Build counter log ~ append-only on the VPS, persists across deploys
build-log.jsonl

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Editor
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# One-off debug artifacts produced by extraction scripts
scripts/_debug_*

# Visual diagnostic outputs from scripts/test_*.py and clean_wood_pngs.py
# (the scripts themselves are committed; their PNG output is not)
scripts/_test_*/
scripts/_cleaned_wood_pngs/
scripts/_audit_orientations/
scripts/_unused_screenshots/

# Local built-modlet test workspace (KitsunePrints/) ~ a dev/QA build of the
# mod. Only the DLL source under Harmony/ is tracked; everything else here
# (ModInfo, the built DLL, Config/Resources/ItemIcons/UIAtlases, .claude) is
# generated build output and stays untracked.
/KitsunePrints/*
!/KitsunePrints/Harmony/
/KitsunePrints/Harmony/obj/
/KitsunePrints/Harmony/bin/

# Unused/scratch image templates (not referenced by the build)
/_templates/
